#!/usr/bin/env zsh

emulate sh 2>/dev/null

set -e

LANG=C LC_COLLATE=C LC_CTYPE=C LC_MESSAGES=C LC_MONETARY=C LC_NUMERIC=C LC_TIME=C LC_ALL=C
export LANG LC_COLLATE LC_CTYPE LC_MESSAGES LC_MONETARY LC_NUMERIC LC_TIME LC_ALL

target_bits=64
target_build_arch=

if [ "$(uname -m)" = arm64 ]; then
    arm64_host=1
    target_cpu=ARM64
else
    intel_host=1
    target_cpu=x86_64
fi

# Extract an architecture flag from the arguments. It may appear anywhere,
# alongside the --debug/--release flags handled by core.sh; all other
# arguments are preserved and passed through to the builder.
argc=$#
while [ "$argc" -gt 0 ]; do
    argc=$((argc - 1))
    case "$1" in
        -[Ii][Nn][Tt][Ee][Ll]|--[Ii][Nn][Tt][Ee][Ll]|-[Ii][Nn][Tt][Ee][Ll]64|--[Ii][Nn][Tt][Ee][Ll]64|-[Xx]86_64|--[Xx]86_64|-64|--64)
            intel_target=1
            target_cpu=x86_64
            ;;
        -[Aa][Rr][Mm]64|--[Aa][Rr][Mm]64|-[Aa][Aa][Rr][Cc][Hh]64|--[Aa][Aa][Rr][Cc][Hh]64)
            arm64_target=1
            target_cpu=ARM64
            ;;
        -32|--32)
            intel_target=1
            target_build_arch=-m32
            target_cpu=i386
            ;;
        *)
            set -- "$@" "$1"
            ;;
    esac
    shift
done

if [ -n "$intel_host" ] && [ -z "$intel_target" ] && [ -z "$arm64_target" ]; then
    intel_target=1
elif [ -n "$arm64_host" ] && [ -z "$arm64_target" ] && [ -z "$intel_target" ]; then
    arm64_target=1
fi

# Intel builds target 10.10 (Yosemite.)
export MACOSX_DEPLOYMENT_TARGET=10.10

if [ -n "$intel_target" ]; then
    target_build_arch="-target x86_64-apple-macos${MACOSX_DEPLOYMENT_TARGET}"
else
    export MACOSX_DEPLOYMENT_TARGET=11.0 # Big Sur

    if [ -n "$intel_host" ]; then
        target_build_arch="-target aarch64-apple-macos${MACOSX_DEPLOYMENT_TARGET}"
    fi
fi

# Need to use Xcode 9 for 32 bit builds on Mojave and newer.
# Place it in /Applications/Xcode9.app .
if [ "$target_cpu" = i386 ] && [ -d /Applications/Xcode9.app ]; then
    PREV_XCODE=$(xcode-select -p)
    printf "\nSetting Xcode9 as the default Xcode for 32 bit build...\n\n"
    sudo xcode-select -s /Applications/Xcode9.app/Contents/Developer
fi

if command -v brew >/dev/null; then
    export BREW_PREFIX=$(brew --prefix)
elif [ -f /usr/local/bin/brew ]; then
    export BREW_PREFIX=$(/usr/local/bin/brew --prefix)
elif [ -f /opt/homebrew/bin/brew ]; then
    export BREW_PREFIX=$(/opt/homebrew/bin/brew --prefix)
fi

if [ -n "$BREW_PREFIX" ]; then
    "$BREW_PREFIX"/bin/brew unlink gettext >/dev/null 2>&1 || :
fi

# MacPorts is the fallback when there is no Homebrew.  Its prefix is two
# directories up from the 'port' command, /opt/local unless it was relocated.
mp_port=$(command -v port 2>/dev/null || :)

if [ -z "$mp_port" ] && [ -x /opt/local/bin/port ]; then
    mp_port=/opt/local/bin/port
fi

if [ -n "$mp_port" ]; then
    export MACPORTS_PREFIX=$(dirname "$(dirname "$mp_port")")
fi

export BUILD_ROOT="${BUILD_ROOT:-$HOME/vbam-build-mac-${target_cpu}}$BUILD_ROOT_SUFFIX"

ver_file=$(mktemp)
sw_vers -productVersion | sed 's/\./ /g' > "$ver_file"
read -r macos_major macos_minor macos_patch < "$ver_file"
rm -f "$ver_file"

# Nix and MacPorts report a bare "clang version 22.1.8" while Homebrew and
# Apple prefix it with the vendor name, so pull the version out of the line
# instead of depending on where it lands in the fields.
clang_version() {
    "$1" --version 2>/dev/null | head -1 | sed -E 's/.*version ([0-9]+(\.[0-9]+)*).*/\1/'
}

# Find the highest version clang and llvm in Nix, Homebrew or MacPorts.
best_llvm_path=$(
    (
        for nix_clang in $(find /nix/store -maxdepth 1 -type d -name '*-clang-[0-9]*[0-9]' 2>/dev/null); do
            llvm_ver=$(echo "$nix_clang" | sed -E 's/.*-([0-9][0-9.]*[0-9])$/\1/')
            nix_llvm=$(find /nix/store -maxdepth 1 -type d -name '*-llvm-'"$llvm_ver" 2>/dev/null)

            if [ -x "$nix_clang/bin/clang++" ]; then
                echo "$nix_clang:$nix_llvm    $(clang_version "$nix_clang/bin/clang++")"
            fi
        done

        for brew_llvm in $(find "$BREW_PREFIX"/Cellar/llvm -maxdepth 1 -type d 2>/dev/null); do
            if [ -x "$brew_llvm/bin/clang++" ]; then
                echo "$brew_llvm    $(clang_version "$brew_llvm/bin/clang++")"
            fi
        done

        # MacPorts gives every clang-NN/llvm-NN pair its own libexec tree; what
        # lands in ${MACPORTS_PREFIX}/bin is only a wrapper script per tool.
        for mp_llvm in $(find "$MACPORTS_PREFIX"/libexec -maxdepth 1 -type d -name 'llvm-[0-9]*' 2>/dev/null); do
            if [ -x "$mp_llvm/bin/clang++" ]; then
                echo "$mp_llvm    $(clang_version "$mp_llvm/bin/clang++")"
            fi
        done
    ) | sort -k2,2 -V -r | head -1 | awk '{ print $1 }'
)

# Fallback to XCode version.
[ -z "$best_llvm_path" ] && best_llvm_path=/usr

if [ -n "$arm64_target" ]; then
    case "$best_llvm_path" in
        /nix/store/*) # Nix
            rt_lib=$(find /nix/store -maxdepth 1 -type d -name '*-compiler-rt-libc-*[0-9]' | while read -r d; do echo $d $(echo $d | sed -E 's/.*-([0-9.]+)$/\1/'); done | sort -V -k 2 | tail -n 1 | awk '{ print $1 }')/lib/libclang_rt.osx.a
            ;;
    esac
fi

if [ -z "$rt_lib" ]; then
    rt_lib=$(xcode-select -p)/Toolchains/XcodeDefault.xctoolchain/usr/lib/clang/"$(/usr/bin/clang --version | head -1 | awk '{ print $4 }')"/lib/darwin/libclang_rt.osx.a
fi

clang_path=${best_llvm_path%%:*}
xcode_path=$(xcode-select -p)

# Apple's clang and Homebrew's locate the SDK by themselves, but the MacPorts
# one emits no -isysroot at all and then cannot find so much as stdio.h, so CC,
# CPP and CXX below name the SDK explicitly.  It goes on the drivers rather
# than in CFLAGS because plenty of callers use $CC or $CPP with none of our
# flag variables: autoconf's preprocessor tests and ffmpeg's host_cc probe
# both do.  xcrun knows which SDK is current; the fallbacks cover the full
# Xcode and the Command Line Tools layouts.
sdk_path=$(xcrun --show-sdk-path 2>/dev/null || :)

if [ ! -d "$sdk_path" ]; then
    if [ -d "$xcode_path/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk" ]; then
        sdk_path="$xcode_path/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
    elif [ -d "$xcode_path/SDKs/MacOSX.sdk" ]; then
        sdk_path="$xcode_path/SDKs/MacOSX.sdk"
    else
        printf "\nCannot find the macOS SDK.\n\n" >&2
        exit 1
    fi
fi

export CMAKE_BASE_ARGS="$CMAKE_BASE_ARGS -DCMAKE_OSX_DEPLOYMENT_TARGET=$MACOSX_DEPLOYMENT_TARGET"

# Homebrew first when both are installed, to keep the existing behavior.
pkg_mgr_path=

if [ -n "$BREW_PREFIX" ]; then
    pkg_mgr_path="$BREW_PREFIX/bin:$BREW_PREFIX/opt/gettext/bin:"
fi

if [ -n "$MACPORTS_PREFIX" ]; then
    pkg_mgr_path="$pkg_mgr_path$MACPORTS_PREFIX/bin:"
fi

BUILD_ENV=$(cat <<EOF
export MACOSX_DEPLOYMENT_TARGET=$MACOSX_DEPLOYMENT_TARGET
export COMMAND_MODE=unix2003
export PATH="$best_llvm_path/bin:$pkg_mgr_path/usr/bin:/bin:/usr/sbin:/sbin"

export CC="$clang_path/bin/clang $target_build_arch -isysroot $sdk_path"
export CPP="$clang_path/bin/clang -E $target_build_arch -isysroot $sdk_path"
export CXX="$clang_path/bin/clang++ $target_build_arch -isysroot $sdk_path"
export ARCHFLAGS="$target_build_arch"
export CPPFLAGS="-DICONV_CONST="
export CFLAGS="-F$sdk_path/System/Library/Frameworks -framework Carbon -framework Foundation -framework CoreServices -framework SystemConfiguration -Wno-unused-command-line-argument -Wno-error=incompatible-function-pointer-types -fpermissive -Wno-error=unguarded-availability"
export CXXFLAGS="-F$sdk_path/System/Library/Frameworks -framework Carbon -framework Foundation -framework CoreServices -framework SystemConfiguration -Wno-unused-command-line-argument -Wno-error=unguarded-availability -nostdinc++ -isystem $sdk_path/usr/include/c++/v1 -isystem $sdk_path/usr/include"
export OBJCXXFLAGS="-F$sdk_path/System/Library/Frameworks -framework Carbon -framework Foundation -framework CoreServices -framework SystemConfiguration -Wno-unused-command-line-argument -Wno-error=unguarded-availability -nostdinc++ -isystem $sdk_path/usr/include/c++/v1 -isystem $sdk_path/usr/include"
export LDFLAGS="-L\"\$BUILD_ROOT/root/lib\" -L$sdk_path/usr/lib -F$sdk_path/System/Library/Frameworks -framework Carbon -framework Foundation -framework CoreServices -framework SystemConfiguration -Wno-unused-command-line-argument -Wl,-no_compact_unwind"

export UUID_CFLAGS="-I\"\$BUILD_ROOT/root/stow/libuuid/include\""
export UUID_LIBS="-L\"\$BUILD_ROOT/root/stow/libuuid/lib\" -luuid"
EOF
)

export BUILD_ENV

export TAR=tar

if [ -f /bin/dash ]; then
    export DASH=/bin/dash
fi

if [ "$target_cpu" = i386 ]; then
    cross_build=1
    export CONFIGURE_REQUIRED_ARGS='--host=i386-apple-darwin --build=x86_64-apple-darwin'
elif [ -n "$arm64_host" ] && [ -n "$intel_target" ]; then
    cross_build=1
    export CONFIGURE_REQUIRED_ARGS='--host=x86_64-apple-darwin --build=aarch64-apple-darwin'
    export CMAKE_BASE_ARGS="-DCMAKE_OSX_ARCHITECTURES=x86_64"
elif [ -n "$intel_host" ] && [ -n "$arm64_target" ]; then
    cross_build=1
    export CONFIGURE_REQUIRED_ARGS='--host=aarch64-apple-darwin --build=x86_64-apple-darwin'
    export CMAKE_BASE_ARGS="-DCMAKE_OSX_ARCHITECTURES=arm64"
fi

. "$(dirname "$0")/../builder/core.sh"

# Remove -lm, macOS does not use it and it can cause build failures.
BUILD_ENV=$(printf '%s' "$BUILD_ENV" | sed 's/ -lm / /g')
export BUILD_ENV

# wxrc runs on the build machine, so a cross build cannot use the one the
# wxwidgets dist just compiled for the target.  Take the package manager's
# instead -- installdeps and the core deps both install a wx that provides it.
if [ -n "$cross_build" ]; then
    for wxrc_dir in "$MACPORTS_PREFIX" "$BREW_PREFIX"; do
        [ -n "$wxrc_dir" ] || continue

        if [ -x "$wxrc_dir/bin/wxrc" ]; then
            PROJECT_ARGS="$PROJECT_ARGS -DWXRC='$wxrc_dir/bin/wxrc'"
            break
        fi
    done
fi

for dist in XML-Parser c2man cmake cmake ccache flex getopt glib graphviz libffi libgcrypt libgpg-error libsecret m4 ninja openssl python2 shared-mime-info swig xorg-macros flac; do
    table_line_remove DISTS $dist
done

table_line_replace DIST_PREFIX libuuid /usr/stow/libuuid

stdint_h=

if [ -f "$(xcode-select -p)/SDKs/MacOSX.sdk/usr/include/stdint.h" ]; then
    stdint_h="\"$(xcode-select -p)\"/SDKs/MacOSX.sdk/usr/include/stdint.h"
elif [ -f "$(xcode-select -p)/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/stdint.h" ]; then
    stdint_h="\"$(xcode-select -p)\"/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/stdint.h"
else
    die "Can't find macOS SDK 'stdint.h'"
fi

table_line_append DIST_EXTRA_CFLAGS ffmpeg    "-include $stdint_h"

# these are only applicable for cross-compiling to 32 bits
if [ "$target_cpu" = i386 ]; then
    # some dists will not cross compile without a CONFIG_SITE
    table_line_append DIST_ARGS pkgconfig '--host= --build='
    table_line_append DIST_ARGS docbook2x '--host= --build='

    # python does not support cross-compiling to 32bits
    table_line_append DIST_ARGS python2 '--host= --build='
    table_line_append DIST_ARGS python3 '--host= --build='

    table_line_append DIST_ARGS libicu '--host= --build='
fi

table_line_append DIST_PRE_BUILD ffmpeg "sed -i.bak 's/-lstdc++/-lc++/g' configure"

# giflib's default target builds shared libraries and the gif utilities, and we
# want neither -- this build is static only.  The dylib link fails outright on
# macOS anyway: libutil calls GifErrorString from libgif and the Makefile links
# the two against nothing, which ld tolerates for an ELF .so but not for a
# Mach-O dylib.  Build and install just the static libraries.  install-* is
# named explicitly because giflib's plain 'install' target depends on 'all'.
table_line_replace DIST_MAKE_ARGS       giflib static-lib
table_line_replace DIST_INSTALL_TARGETS giflib 'install-static-lib install-include'

# For a 10.7 target:
#table_line_replace DISTS wxwidgets "https://github.com/wxWidgets/wxWidgets/releases/download/v3.0.5.1/wxWidgets-3.0.5.1.tar.bz2 lib/libwx_baseu-3.0*.a"

table_line_append DIST_CONFIGURE_OVERRIDES ffmpeg "--disable-videotoolbox --extra-ldflags='-framework CoreText'"

#table_line_append DIST_PATCHES ffmpeg "-p0 https://gist.githubusercontent.com/rkitover/db75d083b74617b186eec11965c1da74/raw/20da2f8c6d8c02ce284096c5e805ae671351cc6e/ffmpeg-macos10-7.patch"

if [ -n "$arm64_host" ] && [ -z "$arm64_target" ]; then
    table_line_append DIST_CONFIGURE_OVERRIDES ffmpeg '--disable-asm'
fi

# Set up cross-compile for ARM64 on Intel.
if [ -n "$arm64_target" ] && [ -z "$arm64_host" ]; then
    table_line_remove DIST_FLAGS               libpng

    table_line_append DIST_FLAGS               gettext       no_install_bin

    table_line_append DIST_CONFIGURE_OVERRIDES ffmpeg        "--enable-cross-compile --arch=aarch64"
fi

builder "$@"

if [ -n "$PREV_XCODE" ]; then
    printf "\nRe-setting '$PREV_XCODE' as the default Xcode...\n\n"
    sudo xcode-select -s "$PREV_XCODE"
fi
