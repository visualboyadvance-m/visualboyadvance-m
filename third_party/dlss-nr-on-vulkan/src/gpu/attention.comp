#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * attention — the row-wise operators: the cosine publish and the bit-affine softmax.
 *
 * One invocation per row, because both reduce along the last axis: 32 channels for the
 * cosine normalise, the window's token count for the softmax.
 *
 * Both reductions are reproduced in the order the reference uses, which had to be
 * measured rather than assumed. `sum(dtype=float16)` in numpy does *not* accumulate in
 * half — it runs sequentially in float32 and rounds once at the end — and the cosine
 * normalise instead uses a fixed fragment tree of half operations, whose shape is the
 * kernel's, not a reduction library's.
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#include "publish.glsl"
#include "cosine_tree.glsl"

layout(local_size_x = 32) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf { float     v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer HalfBuf  { float16_t v[]; };

layout(push_constant, scalar) uniform Push {
    FloatBuf a, b, c, d;
    uint m, n, k, batch;
    uint sa, sb, sc, flags;
    float p0, p1, p2, p3;
    FloatBuf qkv_scale; // offset 80: shares the GEMM-only lda/ldb slots in the C push ABI
} pc;

#include "specialize.glsl"

/* Both row passes read a whole row into one invocation, and a row is 32 or 64
 * consecutive floats: neighbouring invocations then touch addresses 128 or 256 bytes
 * apart and every load instruction spans sixty-four cache lines. Staging the
 * workgroup's rows through shared memory makes the global traffic contiguous — the
 * cosine publish went from 23.7 GB/s to the 80-odd the other passes reach — while each
 * invocation still sees its own row whole, which the vendor's fragment tree requires.
 *
 * The staging is fenced with workgroup-scope barriers, not subgroup ones. The workgroup
 * is 32 wide and was measured where a subgroup is too (Xe2, Apple), but Mali runs 16-wide
 * subgroups, so a subgroup barrier would fence only half the rows -- and the Bifrost/
 * Valhall shader compiler cannot even build a subgroup-scope OpControlBarrier: on a
 * Mali-G57 it aborts the process with "LLVM ERROR: Cannot select: intrinsic
 * %llvm.bifrost.2556" from inside vkCreateComputePipelines (notes/phase73-mali.md).
 * `barrier()` on a single-subgroup workgroup costs the same on the drivers measured. */
shared float stage[32 * 64];

/* `count` consecutive floats from `base`, spread across the workgroup. */
void gather_part(uint base, uint count, uint part) {
    /* Bit 15: the input is float16. The cosine publish rounds its input to half as its
     * first act, so a producer that already wrote half loses nothing by it. */
    if ((operation_flags() & 0x20000u) != 0u) {
        // Q/K directly from (window, token, 3, head, channel). The cosine
        // operation performs the split's half rounding before its reduction.
        if (pc.n % 32u == 0u) {
            // A workgroup's 32 rows stay in one head. Compute its base once,
            // instead of repeating integer division for every gathered element.
            uint row = base / 32u;
            uint head = (row / pc.n) % pc.batch, token = row % pc.n;
            uint window = row / (pc.n * pc.batch);
            uint at = ((window * pc.n + token) * 3u * pc.batch + part * pc.batch + head) * 32u;
            for (uint i = gl_LocalInvocationID.x; i < count; i += 32u)
                stage[i] = pc.a.v[at + (i / 32u) * pc.batch * 96u + i % 32u];
        } else {
            for (uint i = gl_LocalInvocationID.x; i < count; i += 32u) {
                uint row = (base + i) / 32u, channel = (base + i) % 32u;
                uint head = (row / pc.n) % pc.batch, token = row % pc.n;
                uint window = row / (pc.n * pc.batch);
                uint at = ((window * pc.n + token) * 3u * pc.batch + part * pc.batch + head) * 32u + channel;
                stage[i] = pc.a.v[at];
            }
        }
    } else if ((operation_flags() & 0x8000u) != 0u) {
        HalfBuf h = HalfBuf(uint64_t(pc.a));
        for (uint i = gl_LocalInvocationID.x; i < count; i += 32u) stage[i] = float(h.v[base + i]);
    } else
    for (uint i = gl_LocalInvocationID.x; i < count; i += 32u) stage[i] = pc.a.v[base + i];
    memoryBarrierShared();
    barrier();
}

void gather(uint base, uint count) {
    gather_part(base, count, (operation_flags() >> 18) & 1u);
}

void scatter_to(uint base, uint count, uint64_t target) {
    memoryBarrierShared();
    barrier();
    if ((operation_flags() & 0x1000u) != 0u) {
        HalfBuf h = HalfBuf(target);
        for (uint i = gl_LocalInvocationID.x; i < count; i += 32u)
            h.v[base + i] = float16_t(stage[i]);
    } else {
        for (uint i = gl_LocalInvocationID.x; i < count; i += 32u) FloatBuf(target).v[base + i] = stage[i];
    }
}

void scatter(uint base, uint count) { scatter_to(base, count, uint64_t(pc.c)); }

const uint COSINE_PUBLISH = 0u, SOFTMAX = 1u, QKV_PREPARE = 2u;

/* The publish this pass ends with: bits 8-11 of `flags` pick the transform and bit 12
 * narrows the output to float16, so the row passes can feed a GEMM directly instead of
 * writing float32 for a `to_half` pass to read straight back. Both of these rows end in
 * an E4M3 value, which is exact in half, so narrowing here changes nothing. */
void store(uint index, float value) {
    uint epilogue = (operation_flags() >> 8) & 0xFu;
    if (epilogue == 1u) value = e4m3(value);
    else if (epilogue == 4u) value = half_round(value);
    if ((operation_flags() & 0x1000u) != 0u) HalfBuf(uint64_t(pc.c)).v[index] = float16_t(value);
    else                            pc.c.v[index] = value;
}

void cosine_publish(uint row, uint local, bool scaled, FloatBuf scales) {
    uint base = local * 32u;
    float h[32];
    for (uint i = 0u; i < 32u; i++) h[i] = half_round(stage[base + i]);
    float reciprocal = cosine_reciprocal(h);   // cosine_tree.glsl
    // pc.k != 0 selects the query path, which also multiplies by its head's scale
    float scale = 1.0;
    if (scaled) {
        uint head = (row / pc.n) % pc.batch;      // rows are (batch, head, token)
        scale = half_round(scales.v[head]);
    }
    for (uint i = 0u; i < 32u; i++) {
        float value = hmul(h[i], reciprocal);
        if (scaled) value = hmul(value, scale);
        stage[base + i] = e4m3(value);
    }
}

/* One pair of attention weights. The vendor's exp is a bit-affine map on an `f16x2`
 * register, so the pair is coupled — the shift moves bits across the halves and the add
 * can carry between them — and the two elements cannot be computed apart.
 * See notes/phase5-softmax-found.md. */
/* The clamped affine values encode as 0x3c20..0x3e47. For every pair,
 * the coupled transform below yields finite normal half values (0x0400..0x48e0).
 * Native pack/unpack therefore reproduces the former bit reconstruction exactly,
 * including the carry from the low half into the high half. */
void weights_at_fast(bool staged, uint base, uint bias, uint i, out float w0, out float w1) {
    vec2 affine;
    for (uint j = 0u; j < 2u; j++) {
        float logit = staged ? stage[base + i + j] : pc.a.v[base + i + j];
        if ((operation_flags() & 0x2000u) != 0u) logit += pc.b.v[bias + i + j];
        if (pc.p0 != 0.0) logit = clamp(logit, -pc.p0, pc.p0);
        precise float scaled = half_round(logit) * 0.044921875;
        scaled += 1.30078125;
        affine[j] = clamp(scaled, 1.03125, 1.5693359375);
    }
    uint transformed = (packHalf2x16(affine) << 5) + 0x7FF88000u;
    vec2 weights = unpackHalf2x16(transformed);
    w0 = weights.x; w1 = weights.y;
}

#ifdef SOFTMAX_AB
void weights_at_reference(bool staged, uint base, uint bias, uint i, out float w0, out float w1) {
    uint bits[2];
    for (uint j = 0u; j < 2u; j++) {
        float logit = staged ? stage[base + i + j] : pc.a.v[base + i + j];
        /* The per-head attention bias, added here rather than by a pass of its own:
         * it is a few tens of kilobytes and stays in cache, so folding it in costs
         * nothing and saves a whole read-modify-write of the scores. */
        if ((operation_flags() & 0x2000u) != 0u) logit += pc.b.v[bias + i + j];
        if (pc.p0 != 0.0) logit = clamp(logit, -pc.p0, pc.p0);
        precise float scaled = half_round(logit) * 0.044921875;
        scaled += 1.30078125;
        float affine = clamp(scaled, 1.03125, 1.5693359375);
        // the float16 bit pattern of the affine value
        int f = floatBitsToInt(half_round(affine));
        bits[j] = uint(((f >> 13) & 0x3FF) | (((((f >> 23) & 0xFF) - 112) & 0x1F) << 10)
                       | ((f < 0) ? 0x8000 : 0));
    }
    uint transformed = ((bits[0] | (bits[1] << 16)) << 5) + 0x7FF88000u;
    float out2[2];
    for (uint j = 0u; j < 2u; j++) {
        uint half_bits = (j == 0u) ? (transformed & 0xFFFFu) : ((transformed >> 16) & 0xFFFFu);
        uint exponent = (half_bits >> 10) & 0x1Fu, mantissa = half_bits & 0x3FFu;
        float weight = (exponent == 0u)
            ? float(mantissa) * 5.9604644775390625e-08
            : intBitsToFloat(int(((exponent + 112u) << 23) | (mantissa << 13)));
        out2[j] = ((half_bits & 0x8000u) != 0u) ? -weight : weight;
    }
    w0 = out2[0]; w1 = out2[1];
}
#endif

void weights_at(bool staged, uint base, uint bias, uint i, out float w0, out float w1) {
#ifdef SOFTMAX_AB
    // Test-only specialization bit; removed entirely from the shipped shader.
    if ((operation_flags() & 0x40000000u) != 0u) {
        weights_at_reference(staged, base, bias, i, w0, w1);
        return;
    }
#endif
    weights_at_fast(staged, base, bias, i, w0, w1);
}

void softmax(uint row, uint local) {
    /* `n` is the real token count and `sa` the row stride, which differ for the
     * global blocks: their token count is the bottleneck's pixel count and need not
     * be a multiple of the cooperative-matrix tile, so the scores are padded. The pad
     * must not enter the sum, and is zeroed so the following P@V contributes nothing.
     * `p0` is the symmetric logit clamp the vit_1d kernels apply; 0 means none.
     *
     * The weights are computed twice rather than parked in the output buffer between
     * the sum and the normalise: that buffer is the one being narrowed, and reading a
     * half value back would round the total. Recomputing is also the cheaper half of a
     * bandwidth-bound pass. */
    uint stride = pc.sa != 0u ? pc.sa : pc.n;
    bool staged = stride == pc.n && stride <= 64u;
    uint base = staged ? local * stride : row * stride;
    /* scores are (windows*heads, tokens, tokens) and the bias (heads, tokens, tokens) */
    uint bias = ((row / pc.n) % max(pc.batch, 1u)) * pc.n * pc.n + (row % pc.n) * pc.n;
    if (!staged) for (uint i = pc.n; i < stride; i++) store(base + i, 0.0);
    float total = 0.0;
    float w0, w1;
    for (uint i = 0u; i < pc.n; i += 2u) {
        weights_at(staged, base, bias, i, w0, w1);
        /* The weights are parked where the logits were, so the normalising pass does
         * not repeat the bit-affine transform. Only shared memory can hold them: the
         * output buffer is the one being narrowed to float16, and a rounded weight
         * would give a different product. The rows too wide to stage — the bottleneck's,
         * eight calls a frame — pay the transform twice instead. */
        if (staged) { stage[base + i] = w0; stage[base + i + 1u] = w1; }
        total += w0;                              // float32 accumulation, as numpy does
        total += w1;
    }
    float reciprocal = half_round(1.0 / half_round(total));
    if (staged) {
        for (uint i = 0u; i < pc.n; i++)
            stage[base + i] = e4m3(hmul(stage[base + i], reciprocal));
    } else {
        for (uint i = 0u; i < pc.n; i += 2u) {
            weights_at(false, base, bias, i, w0, w1);
            store(base + i,      e4m3(hmul(w0, reciprocal)));
            store(base + i + 1u, e4m3(hmul(w1, reciprocal)));
        }
    }
}

void main() {
    uint row = gl_GlobalInvocationID.x;
    uint kind = operation_flags() & 0xFFu, local = gl_LocalInvocationID.x;
    if (kind == QKV_PREPARE) {
        // Three independent workgroup planes: identical arithmetic to the old
        // Q/K normalizations and V split, recorded as one dispatch and one barrier.
        uint part = gl_WorkGroupID.y;
        uint base = gl_WorkGroupID.x * 32u * 32u;
        uint count = min(32u * 32u, pc.m * 32u - base);
        gather_part(base, count, part);
        if (part < 2u) {
            if (row < pc.m) cosine_publish(row, local, part == 0u, pc.qkv_scale);
        } else {
            for (uint i = local; i < count; i += 32u) stage[i] = e4m3(stage[i]);
        }
        uint64_t target = part == 0u ? uint64_t(pc.b) :
                          (part == 1u ? uint64_t(pc.c) : uint64_t(pc.d));
        scatter_to(base, count, target);
    } else if (kind == COSINE_PUBLISH) {
        uint base = gl_WorkGroupID.x * 32u * 32u;
        gather(base, min(32u * 32u, pc.m * 32u - base));
        if (row < pc.m) cosine_publish(row, local, pc.k != 0u, pc.d);
        scatter(base, min(32u * 32u, pc.m * 32u - base));
    } else if (kind == SOFTMAX) {
        uint stride = pc.sa != 0u ? pc.sa : pc.n;
        if (stride == pc.n && stride <= 64u) {
            uint base = gl_WorkGroupID.x * 32u * stride;
            uint count = min(32u * stride, pc.m * stride - base);
            gather(base, count);
            if (row < pc.m) softmax(row, local);
            scatter(base, count);
        } else {
            if (row < pc.m) softmax(row, local);
        }
    }
}
