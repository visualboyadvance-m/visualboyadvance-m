# bin2c.cmake -- converts binary files into a C header with byte arrays.
#
# Usage (script mode):
#
#   cmake -DOUTPUT=<header.h>
#         -DINPUTS=<file1|file2|...>       '|'-separated list of input files
#         -DSYMBOLS=<sym1|sym2|...>        C identifier for each input
#         [-DNAMES=<name1|name2|...>]      key names for the lookup table
#         [-DTABLE=<table_symbol>]         emit a NULL-terminated lookup table
#         [-DPEM_ONLY=ON]                  keep only PEM certificate blocks
#         -P bin2c.cmake
#
# For every input, the generated header contains
#
#   static const unsigned char <sym>[] = { ..., 0x00 };
#   static const size_t <sym>_size = <size without the trailing NUL>;
#
# The trailing NUL byte makes text data (e.g. PEM) usable as a C string.
#
# If TABLE is given, an array of wxsparkle_blob {name, data, size} entries
# terminated by {NULL, NULL, 0} is emitted, too. An empty INPUTS list with
# TABLE set produces an empty table.

cmake_minimum_required(VERSION 3.16)

if(NOT OUTPUT)
    message(FATAL_ERROR "bin2c: OUTPUT not set")
endif()

string(REPLACE "|" ";" _inputs "${INPUTS}")
string(REPLACE "|" ";" _symbols "${SYMBOLS}")
string(REPLACE "|" ";" _names "${NAMES}")

list(LENGTH _inputs _count)
list(LENGTH _symbols _scount)
if(NOT _count EQUAL _scount)
    message(FATAL_ERROR "bin2c: INPUTS and SYMBOLS must have the same length")
endif()
if(TABLE)
    list(LENGTH _names _ncount)
    if(NOT _count EQUAL _ncount)
        message(FATAL_ERROR "bin2c: INPUTS and NAMES must have the same length")
    endif()
endif()

get_filename_component(_outname "${OUTPUT}" NAME)
string(MAKE_C_IDENTIFIER "${_outname}" _guard)
string(TOUPPER "${_guard}" _guard)

set(_content "/* Generated by bin2c.cmake -- do not edit. */\n\n")
string(APPEND _content "#ifndef ${_guard}\n#define ${_guard}\n\n#include <stddef.h>\n\n")
string(APPEND _content "#ifndef WXSPARKLE_BLOB_DEFINED\n#define WXSPARKLE_BLOB_DEFINED\n")
string(APPEND _content "typedef struct\n{\n    const char *name;\n    const unsigned char *data;\n    size_t size;\n} wxsparkle_blob;\n#endif\n\n")

set(_table_entries "")

if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_i RANGE ${_last})
        list(GET _inputs ${_i} _in)
        list(GET _symbols ${_i} _sym)

        if(NOT EXISTS "${_in}")
            message(FATAL_ERROR "bin2c: input file ${_in} does not exist")
        endif()

        if(PEM_ONLY)
            # Keep only the certificates themselves, dropping the human
            # readable text dumps that some bundles (e.g. OpenBSD's) contain.
            file(READ "${_in}" _text)
            string(REGEX MATCHALL "-----BEGIN CERTIFICATE-----[^-]+-----END CERTIFICATE-----" _certs "${_text}")
            list(LENGTH _certs _ncerts)
            if(_ncerts EQUAL 0)
                message(FATAL_ERROR "bin2c: no PEM certificates found in ${_in}")
            endif()
            string(REPLACE ";" "\n" _pem "${_certs}")
            set(_tmp "${OUTPUT}.pem.tmp")
            file(WRITE "${_tmp}" "${_pem}\n")
            file(READ "${_tmp}" _hex HEX)
            file(REMOVE "${_tmp}")
            string(APPEND _content "/* ${_ncerts} certificates from ${_in} */\n")
        else()
            file(READ "${_in}" _hex HEX)
        endif()

        string(LENGTH "${_hex}" _hexlen)
        math(EXPR _size "${_hexlen} / 2")

        # "0a1b..." -> "0x0a,0x1b,...", 16 bytes per line
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " _bytes "${_bytes}")

        string(APPEND _content "static const unsigned char ${_sym}[] =\n{\n    ${_bytes}0x00\n};\n")
        string(APPEND _content "static const size_t ${_sym}_size = ${_size};\n\n")

        if(TABLE)
            list(GET _names ${_i} _name)
            string(APPEND _table_entries "    { \"${_name}\", ${_sym}, ${_size} },\n")
        endif()
    endforeach()
endif()

if(TABLE)
    string(APPEND _content "static const wxsparkle_blob ${TABLE}[] =\n{\n${_table_entries}    { NULL, NULL, 0 }\n};\n\n")
endif()

string(APPEND _content "#endif /* ${_guard} */\n")

# only touch the file if it changed, to avoid needless rebuilds
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _old)
    if(_old STREQUAL _content)
        file(TOUCH "${OUTPUT}") # keep the build system's timestamps happy
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${_content}")
