<?xml version="1.0"?>
<resource version="2.5.3.0">
  <object class="wxPanel" name="DisplayConfigDlssNrPanel">
    <object class="wxBoxSizer">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <option>1</option>
        <flag>wxALL|wxEXPAND</flag>
        <border>5</border>
        <!-- The DLSS-NR group, built by DisplayConfig::InitDlssNr(). -->
        <object class="wxPanel" name="DlssNrPanel"/>
      </object>
    </object>
  </object>
</resource>
